# Only the source snapshot and the reproducibility assets listed below are tracked.
/*
!/.gitignore
!/README.md
!/README.txt
!/requirements.txt
!/requirements.lock.txt

!/tinychat/
/tinychat/*
!/tinychat/*.py
!/scripts/
/scripts/*
!/scripts/*.py
!/scripts/*.ps1
/scripts/stage2_cleanup.ps1
!/tests/
/tests/*
!/tests/*.py
!/tests/*.ps1
!/configs/
/configs/*
!/configs/pilot.json

!/docs/
/docs/*
!/docs/experiments/
/docs/experiments/*
!/docs/experiments/500m-pilots.json

!/data/
/data/*
!/data/stage1_v1/
/data/stage1_v1/*
!/data/stage1_v1/tokenizer.json

!/evaluation/
/evaluation/*
!/evaluation/stage1_v1/
/evaluation/stage1_v1/*
!/evaluation/stage1_v1/prompts.jsonl
!/evaluation/stage1_v1/prompt_manifest.json
!/evaluation/comparison_v2/
/evaluation/comparison_v2/*
!/evaluation/comparison_v2/prompts.jsonl
!/evaluation/natural_sft_v3/
/evaluation/natural_sft_v3/*
!/evaluation/natural_sft_v3/prompts.jsonl
!/evaluation/natural_sft_v3/prompts_for_overlap.jsonl
!/evaluation/natural_sft_v3/prompt_manifest.json
!/evaluation/natural_sft_v3/prompt_bank.tsv
!/evaluation/natural_sft_v3/scoring_contract.txt

# Keep bytecode, environment files and common local credential formats out.
__pycache__/
*.pyc
.env
.env.*
*.pem
*.key
*.pfx
*.p12
